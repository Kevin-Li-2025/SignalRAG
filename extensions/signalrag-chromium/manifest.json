{
  "manifest_version": 3,
  "name": "SignalRAG for Chromium",
  "description": "Integrate the local SignalRAG search engine into Chromium with omnibox, context menu, and side panel search.",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "omnibox": {
    "keyword": "sr"
  },
  "action": {
    "default_title": "Open SignalRAG",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
